{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Snowify",
  "version": "2.0.0",
  "identifier": "com.nyaku.snowify",
  "build": {
    "frontendDist": "../src/renderer"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' https: http: data: file:; media-src 'self' blob: https: http: file:; connect-src 'self' https: http: ipc: http://ipc.localhost;"
    }
  },
  "bundle": {
    "icon": [
      "../assets/logo.png"
    ],
    "active": true,
    "targets": [
      "appimage",
      "nsis"
    ],
    "category": "Music",
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "snowify"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMwQ0I5RTFDNjk0MzRDQkQKUldTOVRFTnBISjdMd0pFWThRbm9wUXdKVDI3TXBGT2gyVVRDWkpILzlZTG5DdUROZkUwT3JQZ0kK",
      "endpoints": [
        "https://github.com/nyakuoff/Snowify/releases/latest/download/latest.json"
      ]
    }
  }
}
